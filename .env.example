# JARVIS AI Configuration

# OpenAI API Key (optional, for advanced features)
OPENAI_API_KEY=your_api_key_here

# Voice Configuration
WAKE_WORD=jarvis
VOICE_RATE=150
VOICE_VOLUME=0.9
LISTENING_TIMEOUT=10
LANGUAGE=en-US

# Storage and Logging
TASK_STORAGE=tasks.json
LOG_FILE=jarvis.log

# Web UI Configuration
FLASK_PORT=5000
ENABLE_WEB_UI=true

# Timezone
TIMEZONE=UTC